# Supabase values are available from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public application URL. Use http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Do not expose with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=only-if-a-trusted-server-task-requires-it
